NODE_ENV=development
API_PORT=3001
API_ORIGIN=http://localhost:3001
WEB_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017/hotel_dev?replicaSet=rs0
MONGODB_DATABASE=hotel_dev
HOTEL_TIME_ZONE=Asia/Kolkata
HOTEL_CURRENCY=INR
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=24
CSRF_SECRET=replace-with-at-least-32-random-characters
MONGODB_MAX_POOL_SIZE=20
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_WAIT_QUEUE_TIMEOUT_MS=3000
# Seed-only; keep real demo credentials in an untracked local .env file.
DEMO_GUEST_EMAIL=guest@example.test
DEMO_GUEST_PASSWORD=replace-with-local-demo-password
DEMO_STAFF_EMAIL=staff@example.test
DEMO_STAFF_PASSWORD=replace-with-local-demo-password
