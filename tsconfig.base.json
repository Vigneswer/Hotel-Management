{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noImplicitOverride": true, "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true, "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true, "skipLibCheck": true,
    "declaration": true, "sourceMap": true
  }
}
